#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// urob-style key mouse defaults. Must be defined before pointing.h.
#define ZMK_POINTING_DEFAULT_MOVE_VAL 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

// Adding pointing.h to be able to right and middle click
// https://zmk.dev/docs/keymaps/behaviors/mouse-emulation
#include <dt-bindings/zmk/pointing.h>

// 레이어 인덱스 = keymap{} 안 layer 노드의 물리적 순서. dtsi scroller가 raw 인덱스로
// Nav를 참조하므로(trackpad 스크롤 모드 결합점), 순서 변경 시 dtsi scroller 동기 필수.
#define LAYER_Base 0
#define LAYER_Mouse 1
#define LAYER_Nav 2
#define LAYER_Symb 3
#define LAYER_Subl 4
#define LAYER_Apps 5
#define LAYER_Systm 6
#define LAYER_Raycast 7
#define LAYER_Letters 8
#define LAYER_Bluetooth 9
#define LAYER_Numpad 10

// Hyper = Shift + Ctrl + Alt + Cmd 합성 modifier.
// Hammerspoon hyper_actions.lua가 OS-level listener로 받음 (kanata 측도 동일 조합 emit).
#define HYPER(k) LS(LC(LA(LG(k))))

// Home row mod positional (urob 패턴). hold는 반대손·엄지에서만 발동, 같은손
// 키가 뒤따르면 강제 탭(오발 차단). kanata $hrm-lkeys/$hrm-rkeys와 동일 의미.
//
// ZMK는 이 속성에 키 이름을 못 받음 → 위치 인덱스 필수. 인덱스 = Base 레이어
// binding 나열 순서(0~41). 행 단위로 분해해 물리 위치와 대조 가능하게 함:
//   top    L: 0  1  2  3  4  5     R:  6  7  8  9 10 11
//   home   L:12 13 14 15 16 17     R: 18 19 20 21 22 23
//   bottom L:24 25 26 27 28 29     R: 30 31 32 33 34 35
//   thumb  L:36 37 38              R: 39 40 41
#define KEYS_LT  0  1  2  3  4  5
#define KEYS_LH 12 13 14 15 16 17
#define KEYS_LB 24 25 26 27 28 29
#define KEYS_RT  6  7  8  9 10 11
#define KEYS_RH 18 19 20 21 22 23
#define KEYS_RB 30 31 32 33 34 35
#define KEYS_L  KEYS_LT KEYS_LH KEYS_LB
#define KEYS_R  KEYS_RT KEYS_RH KEYS_RB
#define THUMBS  36 37 38 39 40 41

/ {
    behaviors {
        // Home row mods 좌측(a/s/d/f). kanata HRM과 1:1: balanced + tapping-term
        // =$hrm-tap(280) + quick-tap=$hrm-qt(300) + require-prior-idle=$hrm-pi(150)
        // + positional(같은손 강제탭 = $hrm-lkeys). 값 변경 시 mac-common.kbd와 동기.
        hrm_l: hrm_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // Home row mods 우측(j/k/l/;). kanata HRM과 1:1: balanced + tapping-term
        // =$hrm-tap(280) + quick-tap=$hrm-qt(300) + require-prior-idle=$hrm-pi(150)
        // + positional(같은손 강제탭 = $hrm-rkeys). 값 변경 시 mac-common.kbd와 동기.
        hrm_r: hrm_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // Homerow Mod for the right pinky - TailorKey (influenced).
        hrm_w: hrm_w {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            quick-tap-ms = <200>;
            require-prior-idle-ms = <0>;
            retro-tap;
        };

        my_mt: my_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&kp>, <&kp>;
        };

        my_lt: my_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&mo>, <&kp>;
        };

        // hold = &kt(key-toggle, 락 토글), tap = 평문 &kp. 사용: &my_kt LSHFT Y → tap=Y / hold=shift-lock 토글.
        // &htm(<&once>,<&kp>)·&my_mt(<&kp>,<&kp>)로는 hold에 &kt를 못 넣어 별도 variant. g/b/r htm과 동일 감각(tap-preferred/300).
        my_kt: my_kt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&kt>, <&kp>;
        };

        my_mtw: my_mtw {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        // hold-tap with `&once` macro on hold: hold emits keycode 1회 (no OS key-repeat); tap is plain &kp.
        // kanata의 (tap-hold ... (macro M-x))와 동등. 사용 syntax는 &my_mt와 동일: &htm <HOLD-ARG> <TAP-ARG>.
        htm: htm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&once>, <&kp>;
        };

    };
};

/ {

    macros {
        // Once-emit any modifier-encoded keycode via &macro_tap &kp X.
        // 사용 예: &once LG(V) → Cmd+V 1회. &once LS(LC(LA(TAB))) → Shift+Ctrl+Alt+Tab 1회.
        // 어떤 modifier 조합(1~4-modifier)이든 단일 매크로로 처리. modifier 늘어도 매크로 추가 불필요.
        once: once {
            label = "ZM_once";
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings
                = <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>
                ;
        };
    };
};

// Key mouse tuning from urob/zmk-config, excluding NAV/FN layer-dependent
// warp/precision listeners because Toucan has different layer semantics.
&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <500>;
    delay-ms = <0>;
};

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
};

// 36키(Ferris) 스타일 콤보 튜닝. 바깥 키는 그대로 두고 안쪽 손가락 쌍을 추가 액세스 경로로.
// timeout 35ms = 두 키 동시 누름 창(빠른 롤 중 오발 차단). prior-idle 125ms = 직전 입력 후
// 그만큼 쉬어야 첫 콤보 키 인식(연속 타이핑 중 오인식 차단). HRM(s/d·k/l)과 공존하는 핵심 값.
#define TRANSITION_COMBO_TIMEOUT_MS 35
#define TRANSITION_COMBO_PRIOR_IDLE_MS 125

/ {
    combos {
        compatible = "zmk,combos";

        // ===== Base 레이어: 바깥키 기능을 안쪽 쌍으로 (바깥키도 그대로 유지) =====
        combo_tab {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <2 3>;          // W+E
            layers = <LAYER_Base>;
            bindings = <&kp TAB>;
        };
        combo_esc {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <14 15>;        // S+D
            layers = <LAYER_Base>;
            bindings = <&kp ESC>;           // 평문 ESC (nav=q-hold, kanata (s d) esc와 대칭)
        };
        combo_copy {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <26 27>;        // X+C
            layers = <LAYER_Base>;
            bindings = <&kp LG(C)>;
        };
        combo_paste {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <27 28>;        // C+V
            layers = <LAYER_Base>;
            bindings = <&kp LG(V)>;
        };
        combo_cut {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <26 28>;        // X+V (C 건너뜀 — 비인접)
            layers = <LAYER_Base>;
            bindings = <&kp LG(X)>;
        };
        combo_eql {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <8 9>;          // I+O → =
            layers = <LAYER_Base>;
            bindings = <&kp EQUAL>;
        };
        combo_sqt {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <20 21>;        // K+L
            layers = <LAYER_Base>;
            bindings = <&kp SQT>;
        };
        combo_grv {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <19 20>;        // J+K → ` (backtick)
            layers = <LAYER_Base>;
            bindings = <&kp GRAVE>;
        };
        combo_minus {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <7 8>;          // U+I → -
            layers = <LAYER_Base>;
            bindings = <&kp MINUS>;
        };
        combo_lbkt {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <31 32>;        // M+, → [
            layers = <LAYER_Base>;
            bindings = <&kp LBKT>;
        };
        combo_rbkt {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <32 33>;        // ,+. → ]
            layers = <LAYER_Base>;
            bindings = <&kp RBKT>;
        };
        combo_bslh {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <8 21>;         // I+L → \ (o+l에서 이동)
            layers = <LAYER_Base>;
            bindings = <&kp BSLH>;
        };
        combo_cmdtab {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <25 26>;        // Z+X → Cmd+Tab (z-hold과 동일, 추가 경로)
            layers = <LAYER_Base>;
            bindings = <&kp LG(TAB)>;
        };
        combo_qmark {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <33 34>;        // .+/ → ?
            layers = <LAYER_Base>;
            bindings = <&kp LS(FSLH)>;
        };

        // ===== Symb 레이어: base 콤보의 shifted 버전을 같은 쌍에 (shift 없이 sym에서 직접) =====
        combo_sym_ui {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <7 8>;          // U+I → _
            layers = <LAYER_Symb>;
            bindings = <&kp LS(MINUS)>;
        };
        combo_sym_io {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <8 9>;          // I+O → +
            layers = <LAYER_Symb>;
            bindings = <&kp LS(EQUAL)>;
        };
        combo_sym_il {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <8 21>;         // I+L → |
            layers = <LAYER_Symb>;
            bindings = <&kp LS(BSLH)>;
        };
        combo_sym_jk {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <19 20>;        // J+K → ~ (틸트)
            layers = <LAYER_Symb>;
            bindings = <&kp LS(GRAVE)>;
        };
        combo_sym_kl {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <20 21>;        // K+L → "
            layers = <LAYER_Symb>;
            bindings = <&kp LS(SQT)>;
        };
        combo_sym_xc {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <26 27>;        // X+C → + (유지, i+o와 중복)
            layers = <LAYER_Symb>;
            bindings = <&kp LS(EQUAL)>;
        };
        combo_sym_mc {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <31 32>;        // M+, → {
            layers = <LAYER_Symb>;
            bindings = <&kp LS(LBKT)>;
        };
        combo_sym_cd {
            timeout-ms = <TRANSITION_COMBO_TIMEOUT_MS>;
            require-prior-idle-ms = <TRANSITION_COMBO_PRIOR_IDLE_MS>;
            key-positions = <32 33>;        // ,+. → }
            layers = <LAYER_Symb>;
            bindings = <&kp LS(RBKT)>;
        };
    };
};

/ {

    keymap {
        compatible = "zmk,keymap";

        layer_Base {
            display-name = "BASE";
            bindings = <
//    ┌────────────────────────────────┬──────────────────┬────────────────────────┬─────────────────────────┬───────────────────┬──────────────────────┐               ┌─────────────────────┬───────────────┬───────────────┬────────────────────────────────────┬───────────────┬──────┐
//    │ &htm lsft(lctl(lalt(tab))) tab │        Q         │ &my_lt laltYER_Systm W │ &my_lt laltYER_Numpad E │ &htm HYPER(f11) R │          T           │               │    &my_kt lsft Y    │       U       │       I       │ &my_mt lgui(lctl(lalt(lsft(Z)))) O │       P       │  \   │
//    ├────────────────────────────────┼──────────────────┼────────────────────────┼─────────────────────────┼───────────────────┼──────────────────────┤               ├─────────────────────┼───────────────┼───────────────┼────────────────────────────────────┼───────────────┼──────┤
//    │       lt laltYER_Nav esc       │  &hrm_l lgui A   │     &hrm_l lalt S      │      &hrm_l lsft D      │   &hrm_l lctl F   │   &htm lgui(spc) G   │               │          H          │ &hrm_r rctl J │ &hrm_r rsft K │           &hrm_r ralt L            │ &hrm_r rgui ; │  '   │
//    ├────────────────────────────────┼──────────────────┼────────────────────────┼─────────────────────────┼───────────────────┼──────────────────────┤               ├─────────────────────┼───────────────┼───────────────┼────────────────────────────────────┼───────────────┼──────┤
//    │              lsft              │ &htm lgui(tab) Z │     &htm lgui(`) X     │     &htm lgui(C) C      │  &htm lgui(V) V   │  &htm HYPER(f10) B   │               │          N          │       M       │       ,       │                 .                  │       /       │ rsft │
//    └────────────────────────────────┴──────────────────┴────────────────────────┴─────────────────────────┼───────────────────┼──────────────────────┼─────┐   ┌─────┼─────────────────────┼───────────────┼───────────────┴────────────────────────────────────┴───────────────┴──────┘
//                                                                                                           │ mo laltYER_Mouse  │ lt laltYER_Symb bspc │ spc │   │ spc │ lt laltYER_Subl ent │   lsft(spc)   │
//                                                                                                           └───────────────────┴──────────────────────┴─────┘   └─────┴─────────────────────┴───────────────┘
  &kp LS(LC(LA(TAB)))       &my_lt LAYER_Nav Q   &my_lt LAYER_Systm W   &my_lt LAYER_Numpad E   &kp R   &htm HYPER(F11) T                                             &kp Y                &kp U            &kp I            &my_mt LG(LC(LA(LS(Z)))) O   &kp P              &none
  &my_kt LSHFT LS(SPACE)     &hrm_l LGUI A    &hrm_l LALT S          &hrm_l LSHFT D          &hrm_l LCTRL F      &htm LG(SPACE) G                                  &kp H                &hrm_r RCTRL J   &hrm_r RSHFT K   &hrm_r RALT L                &hrm_r RGUI SEMI   &none
  &kp LSHFT                  &htm LG(TAB) Z   &htm LG(GRAVE) X       &htm LG(C) C            &htm LG(V) V        &htm HYPER(F10) B                                 &kp N                &kp M            &kp COMMA        &kp DOT                      &kp FSLH           &kp RSHFT
                                                                                             &mo LAYER_Mouse     &lt LAYER_Symb BSPC   &kp SPACE       &kp SPACE   &lt LAYER_Subl RET   &none
            >;
        };

        layer_Mouse {
            display-name = "MOUS";
            // 좌엄지 최외곽 hold로 진입(momentary). 좌 home row = 기존 클릭 유지.
            // 우측 하프 = vim-like key mouse cluster. 트랙패드는 포인터 모드 유지.
            bindings = <
//    ┌─────┬─────┬──────┬──────┬──────┬─────┐                ┌────────────────┬────────────────┬────────────────┬────────────────┬─────┬─────┐
//    │     │     │      │      │      │     │                │ &msc SCRL_left │  &msc SCRL_up  │ &msc SCRL_down │ &msc SCRL_rght │     │     │
//    ├─────┼─────┼──────┼──────┼──────┼─────┤                ├────────────────┼────────────────┼────────────────┼────────────────┼─────┼─────┤
//    │     │     │ mclk │ rclk │ lclk │     │                │ &mmv MOVE_left │ &mmv MOVE_down │  &mmv MOVE_up  │ &mmv MOVE_rght │     │     │
//    ├─────┼─────┼──────┼──────┼──────┼─────┤                ├────────────────┼────────────────┼────────────────┼────────────────┼─────┼─────┤
//    │     │     │      │      │      │     │                │                │                │                │                │     │     │
//    └─────┴─────┴──────┴──────┼──────┼─────┼─────┐   ┌──────┼────────────────┼────────────────┼────────────────┴────────────────┴─────┴─────┘
//                              │      │     │     │   │ lclk │      rclk      │      mclk      │
//                              └──────┴─────┴─────┘   └──────┴────────────────┴────────────────┘
  &trans   &trans   &trans      &trans      &trans      &trans                            &msc SCRL_LEFT   &msc SCRL_UP     &msc SCRL_DOWN   &msc SCRL_RIGHT   &trans   &trans
  &trans   &trans   &mkp MCLK   &mkp RCLK   &mkp LCLK   &trans                            &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP     &mmv MOVE_RIGHT   &trans   &trans
  &trans   &trans   &trans      &trans      &trans      &trans                            &trans           &trans           &trans           &trans            &trans   &trans
                                            &trans      &trans   &trans       &mkp LCLK   &mkp RCLK        &mkp MCLK
            >;
        };

        layer_Nav {
            display-name = "NAVI";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬──────────┐                ┌──────┬──────┬──────┬──────┬─────┬─────┐
//    │     │     │     │     │     │          │                │ home │ pgdn │ pgup │ end  │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼──────────┤                ├──────┼──────┼──────┼──────┼─────┼─────┤
//    │     │     │     │     │     │ HYPER(G) │                │ left │ down │  up  │ rght │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼──────────┤                ├──────┼──────┼──────┼──────┼─────┼─────┤
//    │     │     │     │     │     │ HYPER(2) │                │      │      │      │      │     │     │
//    └─────┴─────┴─────┴─────┼─────┼──────────┼──────┐   ┌─────┼──────┼──────┼──────┴──────┴─────┴─────┘
//                            │     │   rclk   │ mclk │   │     │      │      │
//                            └─────┴──────────┴──────┘   └─────┴──────┴──────┘
  &none    &none    &none    &none    &none    &none                                    &kp HOME   &kp PG_DN   &kp PG_UP   &kp END     &none   &none
  &none    &trans   &trans   &trans   &trans   &kp HYPER(G)                             &kp LEFT   &kp DOWN    &kp UP      &kp RIGHT   &none   &none
  &trans   &none    &none    &none    &none    &kp HYPER(N2)                            &none      &none       &none       &none       &none   &trans
                                      &trans   &mkp RCLK       &mkp MCLK       &trans   &trans     &trans
            >;
        };

        layer_Symb {
            display-name = "SYMB";
            bindings = <
//    ┌─────────┬─────────┬─────────┬─────────┬─────────┬─────────┐               ┌─────────┬─────────┬─────────┬─────────┬─────────┬───┐
//    │ lsft(-) │ lsft(1) │ lsft(2) │ lsft(3) │ lsft(4) │ lsft(5) │               │ lsft(6) │ lsft(7) │ lsft(8) │ lsft(9) │ lsft(0) │ - │
//    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤               ├─────────┼─────────┼─────────┼─────────┼─────────┼───┤
//    │ lsft(`) │    1    │    2    │    3    │    4    │    5    │               │    6    │    7    │    8    │    9    │    0    │ ` │
//    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤               ├─────────┼─────────┼─────────┼─────────┼─────────┼───┤
//    │ lsft(=) │ lsft(,) │ lsft(.) │ lsft(/) │    [    │    ]    │               │ lsft([) │ lsft(]) │    ,    │    .    │    /    │ = │
//    └─────────┴─────────┴─────────┴─────────┼─────────┼─────────┼─────┐   ┌─────┼─────────┼─────────┼─────────┴─────────┴─────────┴───┘
//                                            │         │         │     │   │     │  bspc   │         │
//                                            └─────────┴─────────┴─────┘   └─────┴─────────┴─────────┘
  &kp LS(MINUS)   &kp LS(N1)      &kp LS(N2)    &kp LS(N3)     &kp LS(N4)   &kp LS(N5)                         &kp LS(N6)     &kp LS(N7)     &kp LS(N8)   &kp LS(N9)   &kp LS(N0)   &kp MINUS
  &kp LS(GRAVE)   &kp N1          &kp N2        &kp N3         &kp N4       &kp N5                             &kp N6         &kp N7         &kp N8       &kp N9       &kp N0       &kp GRAVE
  &kp LS(EQUAL)   &kp LS(COMMA)   &kp LS(DOT)   &kp LS(FSLH)   &kp LBKT     &kp RBKT                           &kp LS(LBKT)   &kp LS(RBKT)   &kp COMMA    &kp DOT      &kp FSLH     &kp EQUAL
                                                               &trans       &trans       &trans       &trans   &kp BSPC       &trans
            >;
        };

        layer_Subl {
            display-name = "SUBL";
            bindings = <
//    ┌─────┬─────┬────────────────────┬─────┬────────────────────┬──────────────────────┐               ┌─────┬─────┬─────┬─────┬─────┬─────┐
//    │     │     │                    │     │ mo laltYER_Raycast │                      │               │     │     │     │     │     │     │
//    ├─────┼─────┼────────────────────┼─────┼────────────────────┼──────────────────────┤               ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │ mo laltYER_Letters │     │                    │                      │               │     │     │     │     │     │     │
//    ├─────┼─────┼────────────────────┼─────┼────────────────────┼──────────────────────┤               ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │                    │     │                    │ mo laltYER_Bluetooth │               │     │     │     │     │     │     │
//    └─────┴─────┴────────────────────┴─────┼────────────────────┼──────────────────────┼─────┐   ┌─────┼─────┼─────┼─────┴─────┴─────┴─────┘
//                                           │                    │   mo laltYER_Apps    │     │   │     │     │     │
//                                           └────────────────────┴──────────────────────┴─────┘   └─────┴─────┴─────┘
  &trans   &trans   &trans              &trans   &mo LAYER_Raycast   &trans                                      &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &mo LAYER_Letters   &trans   &trans              &trans                                      &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans              &trans   &trans              &mo LAYER_Bluetooth                         &trans   &trans   &trans   &trans   &trans   &trans
                                                 &trans              &mo LAYER_Apps        &trans       &trans   &trans   &trans
            >;
        };

        layer_Apps {
            display-name = "APPS";
            // positional Hyper passthrough (영구 동결): 각 글자 키 = 자기 문자의 Hyper emit.
            // 앱 매핑은 Hammerspoon hyper_actions.lua apps 테이블이 단독 관리 — 앱 churn 시 이 레이어 수정 불요.
            // tab = alt-tab, ; = Ghostty quick-term (글자 영역 밖이라 유지).
            bindings = <
//    ┌───────────────────────┬──────────┬──────────┬──────────┬──────────┬──────────┐               ┌──────────┬──────────┬──────────┬──────────┬──────────┬─────┐
//    │ lsft(lctl(lalt(tab))) │ HYPER(Q) │ HYPER(W) │ HYPER(E) │ HYPER(R) │ HYPER(T) │               │ HYPER(Y) │ HYPER(U) │ HYPER(I) │ HYPER(O) │ HYPER(P) │     │
//    ├───────────────────────┼──────────┼──────────┼──────────┼──────────┼──────────┤               ├──────────┼──────────┼──────────┼──────────┼──────────┼─────┤
//    │                       │ HYPER(A) │ HYPER(S) │ HYPER(D) │ HYPER(F) │ HYPER(G) │               │ HYPER(H) │ HYPER(J) │ HYPER(K) │ HYPER(L) │ HYPER(;) │     │
//    ├───────────────────────┼──────────┼──────────┼──────────┼──────────┼──────────┤               ├──────────┼──────────┼──────────┼──────────┼──────────┼─────┤
//    │                       │ HYPER(Z) │ HYPER(X) │ HYPER(C) │ HYPER(V) │ HYPER(B) │               │ HYPER(N) │ HYPER(M) │          │          │          │     │
//    └───────────────────────┴──────────┴──────────┴──────────┼──────────┼──────────┼─────┐   ┌─────┼──────────┼──────────┼──────────┴──────────┴──────────┴─────┘
//                                                             │          │          │     │   │     │          │          │
//                                                             └──────────┴──────────┴─────┘   └─────┴──────────┴──────────┘
  &kp LS(LC(LA(TAB)))   &kp HYPER(Q)   &kp HYPER(W)   &kp HYPER(E)   &kp HYPER(R)   &kp HYPER(T)                         &kp HYPER(Y)   &kp HYPER(U)   &kp HYPER(I)   &kp HYPER(O)   &kp HYPER(P)      &none
  &none                 &kp HYPER(A)   &kp HYPER(S)   &kp HYPER(D)   &kp HYPER(F)   &kp HYPER(G)                         &kp HYPER(H)   &kp HYPER(J)   &kp HYPER(K)   &kp HYPER(L)   &kp HYPER(SEMI)   &none
  &trans                &kp HYPER(Z)   &kp HYPER(X)   &kp HYPER(C)   &kp HYPER(V)   &kp HYPER(B)                         &kp HYPER(N)   &kp HYPER(M)   &none          &none          &none             &trans
                                                                     &trans         &trans         &trans       &trans   &trans         &trans
            >;
        };

        layer_Systm {
            display-name = "SYST";
            bindings = <
//    ┌─────┬────────────┬─────┬─────────────────────┬──────┬─────┐               ┌─────┬─────┬────┬────┬─────┬─────┐
//    │     │ HYPER(f13) │     │        volu         │ bri+ │     │               │     │ f7  │ f8 │ f9 │ f10 │ f11 │
//    ├─────┼────────────┼─────┼─────────────────────┼──────┼─────┤               ├─────┼─────┼────┼────┼─────┼─────┤
//    │     │            │     │        vold         │ bri- │     │               │     │ f4  │ f5 │ f6 │     │ f12 │
//    ├─────┼────────────┼─────┼─────────────────────┼──────┼─────┤               ├─────┼─────┼────┼────┼─────┼─────┤
//    │     │            │     │ lgui(lsft(lctl(4))) │      │     │               │     │ f1  │ f2 │ f3 │     │     │
//    └─────┴────────────┴─────┴─────────────────────┼──────┼─────┼─────┐   ┌─────┼─────┼─────┼────┴────┴─────┴─────┘
//                                                   │      │     │     │   │     │     │     │
//                                                   └──────┴─────┴─────┘   └─────┴─────┴─────┘
  &trans   &kp HYPER(F13)   &none   &kp K_VOL_UP         &kp C_BRI_UP   &none                          &none    &kp F7   &kp F8   &kp F9   &kp F10   &kp F11
  &none    &none            &none   &kp K_VOL_DN         &kp C_BRI_DN   &none                          &none    &kp F4   &kp F5   &kp F6   &none     &kp F12
  &trans   &none            &none   &kp LG(LS(LC(N4)))   &none          &none                          &none    &kp F1   &kp F2   &kp F3   &none     &trans
                                                         &trans         &trans   &trans       &trans   &trans   &trans
            >;
        };

        layer_Raycast {
            display-name = "RAYC";
            // positional Hyper passthrough (영구 동결): home row = Hyper+F1~F10, top row = Hyper+1~0.
            // deeplink 매핑은 Hammerspoon hyper_actions.lua raycast_extensions 테이블이 단독 관리.
            bindings = <
//    ┌─────┬───────────┬───────────┬───────────┬───────────┬───────────┐               ┌───────────┬───────────┬───────────┬───────────┬────────────┬─────┐
//    │     │ HYPER(1)  │ HYPER(2)  │ HYPER(3)  │ HYPER(4)  │ HYPER(5)  │               │ HYPER(6)  │ HYPER(7)  │ HYPER(8)  │ HYPER(9)  │  HYPER(0)  │     │
//    ├─────┼───────────┼───────────┼───────────┼───────────┼───────────┤               ├───────────┼───────────┼───────────┼───────────┼────────────┼─────┤
//    │     │ HYPER(f1) │ HYPER(f2) │ HYPER(f3) │ HYPER(f4) │ HYPER(f5) │               │ HYPER(f6) │ HYPER(f7) │ HYPER(f8) │ HYPER(f9) │ HYPER(f10) │     │
//    ├─────┼───────────┼───────────┼───────────┼───────────┼───────────┤               ├───────────┼───────────┼───────────┼───────────┼────────────┼─────┤
//    │     │           │           │           │           │           │               │           │           │           │           │            │     │
//    └─────┴───────────┴───────────┴───────────┼───────────┼───────────┼─────┐   ┌─────┼───────────┼───────────┼───────────┴───────────┴────────────┴─────┘
//                                              │           │           │     │   │     │           │           │
//                                              └───────────┴───────────┴─────┘   └─────┴───────────┴───────────┘
  &none   &kp HYPER(N1)   &kp HYPER(N2)   &kp HYPER(N3)   &kp HYPER(N4)   &kp HYPER(N5)                       &kp HYPER(N6)   &kp HYPER(N7)   &kp HYPER(N8)   &kp HYPER(N9)   &kp HYPER(N0)    &none
  &none   &kp HYPER(F1)   &kp HYPER(F2)   &kp HYPER(F3)   &kp HYPER(F4)   &kp HYPER(F5)                       &kp HYPER(F6)   &kp HYPER(F7)   &kp HYPER(F8)   &kp HYPER(F9)   &kp HYPER(F10)   &none
  &none   &none           &none           &none           &none           &none                               &none           &none           &none           &none           &none            &none
                                                          &none           &none           &none       &none   &none           &none
            >;
        };

        layer_Letters {
            display-name = "LTRS";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬─────┐               ┌────────────┬─────┬─────┬─────┬─────┬─────┐
//    │     │     │     │     │     │     │               │            │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤               ├────────────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │               │            │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤               ├────────────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │               │ HYPER(f14) │     │     │     │     │     │
//    └─────┴─────┴─────┴─────┼─────┼─────┼─────┐   ┌─────┼────────────┼─────┼─────┴─────┴─────┴─────┘
//                            │     │     │     │   │     │            │     │
//                            └─────┴─────┴─────┘   └─────┴────────────┴─────┘
  &none    &none   &none   &none   &none    &none                          &none            &none    &none   &none   &none   &none
  &none    &none   &none   &none   &none    &none                          &none            &none    &none   &none   &none   &none
  &trans   &none   &none   &none   &none    &none                          &kp HYPER(F14)   &none    &none   &none   &none   &trans
                                   &trans   &trans   &trans       &trans   &trans           &trans
            >;
        };

        layer_Bluetooth {
            display-name = "BLUE";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬─────┐               ┌────────┬─────────────────┬────────────────┬──────────┬──────────┬──────────┐
//    │     │     │     │     │     │     │               │        │ to laltYER_Base │ to laltYER_Nav │          │          │          │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤               ├────────┼─────────────────┼────────────────┼──────────┼──────────┼──────────┤
//    │     │     │     │     │     │     │               │ bt_clr │    bt_sel 0     │    bt_sel 1    │ bt_sel 2 │ bt_sel 3 │ bt_sel 4 │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤               ├────────┼─────────────────┼────────────────┼──────────┼──────────┼──────────┤
//    │     │     │     │     │     │     │               │        │                 │                │          │          │          │
//    └─────┴─────┴─────┴─────┼─────┼─────┼─────┐   ┌─────┼────────┼─────────────────┼────────────────┴──────────┴──────────┴──────────┘
//                            │     │     │     │   │     │        │                 │
//                            └─────┴─────┴─────┘   └─────┴────────┴─────────────────┘
  &trans   &trans   &trans   &trans   &trans   &trans                         &trans       &to LAYER_Base   &to LAYER_Nav   &trans         &trans         &trans
  &trans   &trans   &trans   &trans   &trans   &trans                         &bt BT_CLR   &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4
  &trans   &trans   &trans   &trans   &trans   &trans                         &trans       &trans           &trans          &trans         &trans         &trans
                                      &trans   &trans   &trans       &trans   &trans       &trans
            >;
        };

        layer_Numpad {
            display-name = "NUMB";
            bindings = <
//    ┌─────────┬─────┬─────┬─────┬─────┬─────┐               ┌─────┬─────┬───┬───┬─────┬─────────┐
//    │         │     │     │     │     │     │               │     │  7  │ 8 │ 9 │     │ lsft(8) │
//    ├─────────┼─────┼─────┼─────┼─────┼─────┤               ├─────┼─────┼───┼───┼─────┼─────────┤
//    │         │     │     │     │     │     │               │     │  4  │ 5 │ 6 │  .  │    -    │
//    ├─────────┼─────┼─────┼─────┼─────┼─────┤               ├─────┼─────┼───┼───┼─────┼─────────┤
//    │ lsft(=) │     │     │     │     │     │               │     │  1  │ 2 │ 3 │     │    =    │
//    └─────────┴─────┴─────┴─────┼─────┼─────┼─────┐   ┌─────┼─────┼─────┼───┴───┴─────┴─────────┘
//                                │     │     │     │   │     │  0  │     │
//                                └─────┴─────┴─────┘   └─────┴─────┴─────┘
  &trans          &none    &none    &trans   &none    &none                          &none    &kp N7   &kp N8   &kp N9   &none     &kp LS(N8)
  &none           &trans   &trans   &trans   &trans   &none                          &none    &kp N4   &kp N5   &kp N6   &kp DOT   &kp MINUS
  &kp LS(EQUAL)   &none    &none    &none    &none    &none                          &none    &kp N1   &kp N2   &kp N3   &none     &kp EQUAL
                                             &trans   &trans   &trans       &trans   &kp N0   &trans
            >;
        };

    };
};
